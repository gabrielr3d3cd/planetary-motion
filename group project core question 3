    "import numpy as np\n",
    "import matplotlib as plt\n",
    "\n",
    "G = 6.67348e-11\n",
    "Mass_sun = 1.989e30\n",
    "R_orbit = 149.6e9\n",
    "\n",
    "r0 = np.array([R_orbit, 0.0])\n",
    "v0 = np.array([0.0, 29800.0])\n",
    "\n",
    "def acceleration(r):\n",
    "    x = r[0]\n",
    "    y = r[1]\n",
    "\n",
    "    r_abs = (x**2 + y**2) ** 0.5\n",
    "    ax = -G * Mass_sun * x / (r_abs**3)\n",
    "    ay = -G * Mass_sun * y / (r_abs**3)\n",
    "\n",
    "    return np.array([ax, ay])\n",
    "\n"
